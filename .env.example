# AgroPulse — full-stack configuration

PORT=4070
NODE_ENV=development

NEXT_PUBLIC_APP_NAME=AgroPulse
NEXT_PUBLIC_APP_URL=http://localhost:4070
NEXT_PUBLIC_DEFAULT_CURRENCY=DZD
NEXT_PUBLIC_DEFAULT_WEIGHT_UNIT=quintal

TZ=Africa/Algiers

MONGODB_URI=mongodb://127.0.0.1:27017/agropulse
JWT_SECRET=CHANGE_THIS_TO_LONG_RANDOM_SECRET_KEY
JWT_EXPIRES_IN=7d
COOKIE_NAME=agropulse_token

# Default password for all seeded system accounts (owner, admin, manager)
SEED_PASSWORD=1421998A

# Legacy overrides (optional)
ADMIN_NAME=Owner
ADMIN_USERNAME=owner
ADMIN_EMAIL=owner@tasks.cash
ADMIN_PHONE=+213000000000
ADMIN_PASSWORD=1421998A
